{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rmccc.dev/schemas/manifest.schema.json",
  "title": "RMCCC Plugin Manifest v1",
  "description": "Declarative plugin manifest. Phase 2 accepts data-only plugins (themes, translations, dashboard card declarations); entry.ui and entry.logic are rejected by the installer until Phase 4/5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "publisher",
    "compatibility"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/pluginId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/publisherId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginApi"],
      "properties": {
        "pluginApi": {
          "type": "string",
          "pattern": "^[0-9]+\\.x$"
        },
        "core": {
          "$ref": "#/$defs/versionRange"
        },
        "platforms": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "darwin-aarch64",
              "darwin-x86_64",
              "windows-x86_64",
              "windows-aarch64",
              "linux-x86_64",
              "linux-aarch64"
            ]
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "$ref": "#/$defs/packagePath"
        },
        "logic": {
          "$ref": "#/$defs/packagePath"
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability"],
        "properties": {
          "capability": {
            "$ref": "#/$defs/capability"
          },
          "hosts": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/host"
            }
          },
          "instances": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}$"
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dashboardCards": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/dashboardCard"
          }
        },
        "settingsPages": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/settingsPage"
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/theme"
          }
        }
      }
    },
    "extensionDependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {
            "$ref": "#/$defs/pluginId"
          },
          "version": {
            "$ref": "#/$defs/versionRange"
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "$defs": {
    "pluginId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "publisherId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "localId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+([0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*))?$"
    },
    "versionRange": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(\\*|(\\^|~|>=|<=|>|<|=)?\\s*[0-9]+(\\.[0-9]+|\\.[x*])?(\\.[0-9]+|\\.[x*])?([ ].*)?)$"
    },
    "packagePath": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "capability": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9_]*)+|credentials\\.use:[a-z][a-z0-9-]{1,31})$"
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(\\*\\.)?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h"],
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "dashboardCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "defaultSize"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "defaultSize": {
          "$ref": "#/$defs/size"
        },
        "minSize": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "settingsPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "path": {
          "$ref": "#/$defs/packagePath"
        }
      }
    }
  }
}
