{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-rmccc-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["host"],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "default": "status.example.net"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 25565
    },
    "showMotd": {
      "type": "boolean",
      "default": true
    }
  }
}
