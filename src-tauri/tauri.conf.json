{
  "$schema": "https://raw.githubusercontent.com/nicois/tauri/HEAD/crates/tauri-cli/schema.json",
  "productName": "RMCCC",
  "version": "0.1.0",
  "identifier": "com.rmccc.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "RMCCC",
        "label": "main",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5OEEwODEyQjJDMUQxQ0MKUldUTTBjR3lFZ2lLV1hlbUFsOFR2cGRqOXdqSE9Mb3h3WGtJbjNrR00vZXcyWGV6RWhkVXlhNmsK",
      "endpoints": [
        "https://github.com/<owner>/<repo>/releases/latest/download/latest.json"
      ]
    }
  }
}
